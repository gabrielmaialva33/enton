# .env.example - Enton Configuration

# AI Providers (Local First)
BRAIN_PROVIDER=local
TTS_PROVIDER=local
STT_PROVIDER=local

# Camera (RTSP or Index)
CAMERA_SOURCE=0
CAMERA_IP=192.168.1.50  # Example
CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH=/live/ch0

# Robot Body - Yoosee SC-B21 (see docs/hardware/robot_body.md)
# Default lab IP. ONVIF/telnet/RTSP all use this IP.
ROBOT_BODY_IP=192.168.1.5
ROBOT_BODY_ONVIF_PORT=5000
ROBOT_BODY_TELNET_PORT=23
ROBOT_BODY_RTSP_PATH=/cam/realmonitor  # dual-lens stream without auth

# Output dirs — absolute paths
# Recommended for local dev: use ./tmp/* inside the repo (gitignored).
# For production: external drive or ~/.enton/*.
MEMORY_ROOT=~/.enton/memory
FRAMES_DIR=~/.enton/frames
SKILLS_DIR=~/.enton/skills
BLOB_STORE_ROOT=/media/your-user/Memory Dump/enton
BLOB_STORE_FALLBACK=~/.enton/blobs
WORKSPACE_ROOT=/media/your-user/Memory Dump/enton/workspace
WORKSPACE_FALLBACK=~/.enton/workspace

# Passwords and Keys (Optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEYS=
HUGGINGFACE_TOKEN=
GOOGLE_PROJECT=

# Database and Services
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
TIMESCALE_DSN=postgresql://enton:enton@localhost:5432/enton

# Behavior
BRAIN_TIMEOUT=30.0
IDLE_TIMEOUT=30.0
REACTION_COOLDOWN=5.0